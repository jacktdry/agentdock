{
  "name": "agentdock-shared-desktop-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build:dev": "vue-tsc --noEmit && vite build --minify false --mode development",
    "build": "vue-tsc --noEmit && vite build --mode production",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0-beta.27",
    "pinia": "4.0.3",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.11",
    "@types/node": "24.9.1"
  }
}
