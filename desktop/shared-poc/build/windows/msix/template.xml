<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="agentdock-shared-poc"
        Arguments=""
        InstallLocation="C:\Program Files\AgentDock Custom\AgentDock Shared Desktop POC">
    </Installer>
    <PackageInformation
        PackageName="AgentDock Shared Desktop POC"
        PackageDisplayName="AgentDock Shared Desktop POC"
        PublisherName="CN=AgentDock Custom"
        PublisherDisplayName="AgentDock Custom"
        Version="0.1.0.0"
        PackageDescription="AgentDock cross-platform desktop architecture spike">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="dev.agentdock.sharedpoc"
                Description="AgentDock cross-platform desktop architecture spike"
                DisplayName="AgentDock Shared Desktop POC"
                ExecutableName="agentdock-shared-poc"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>AgentDock Shared Desktop POC</DisplayName>
            <PublisherDisplayName>AgentDock Custom</PublisherDisplayName>
            <Description>AgentDock cross-platform desktop architecture spike</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="agentdock-shared-poc.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
