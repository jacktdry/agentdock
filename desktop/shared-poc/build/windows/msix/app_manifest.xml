<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap3">

  <Identity
    Name="dev.agentdock.sharedpoc"
    Publisher="CN=AgentDock Custom"
    Version="0.1.0.0"
    ProcessorArchitecture="arm64" />

  <Properties>
    <DisplayName>AgentDock Shared Desktop POC</DisplayName>
    <PublisherDisplayName>AgentDock Custom</PublisherDisplayName>
    <Description>AgentDock cross-platform desktop architecture spike</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="dev.agentdock.sharedpoc" Executable="agentdock-shared-poc" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="AgentDock Shared Desktop POC"
        Description="AgentDock cross-platform desktop architecture spike"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <desktop:Extension Category="windows.fullTrustProcess" Executable="agentdock-shared-poc" />


      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />

  </Capabilities>
</Package>
